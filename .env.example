#
# AI Graph - Environment Configuration
# Copy this file to .env and fill in your values.
#

# ── MySQL Database ──
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=test

# ── DeepSeek API (AI Decision Engine) ──
# Get your API key from https://platform.deepseek.com/
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── Semantic Retrieval (Embedding Model) ──
# First run will download the model from Hugging Face.
# Set HF_HOME to choose cache location (recommended on Windows).
HF_HOME=
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_BATCH_SIZE=256
LLM_CONCURRENCY=4
RELATIONSHIP_PLAN_LIMIT=20
